# Copy to .env and fill in. One Venice key powers LLM + image + TTS.
VENICE_API_KEY=your_venice_inference_key_here
# Optional overrides (defaults shown):
# VENICE_BASE_URL=https://api.venice.ai/api/v1
# VENICE_LLM_MODEL=qwen3-235b-a22b-instruct-2507
# VENICE_IMAGE_MODEL=z-image-turbo
# VENICE_TTS_MODEL=tts-kokoro
# VENICE_TTS_VOICE=af_sky
# VENICE_EDIT_MODEL=qwen-image-2-edit
# DALANG_FONT=            # TTF path for caption drawtext (default: DejaVu / a system font)
# DALANG_MUSIC_DIR=       # dir of <mood>.mp3 beds (warm/tense/upbeat/noir) to override the bundled ones
# DALANG_TITLE_SEC=1.6    # branded title-card length (bookends); DALANG_END_SEC=2.2 for the end card
# Ops (optional):
# Cinematic tier (image-to-video, PREMIUM ~$0.55/shot — only used when cinematic=True):
# VENICE_VIDEO_MODEL=wan-2-7-image-to-video
# VENICE_VIDEO_RESOLUTION=720p       # 720p | 1080p
# VENICE_VIDEO_DURATION=5s           # wan: 5s | 10s | 15s
# DALANG_MAX_VIDEO_SHOTS=6           # cost guard: cap animated shots per render
# Ops (optional):
# DALANG_ACCESS_KEY=       # if set, the tool requires a matching access_key (protect a public /mcp)
# x402 / X Layer native paid endpoint (OKX A2MCP) — set DALANG_X402_PAYTO to enable.
# The paid tools/call then returns HTTP 402 until paid in USDT0 on X Layer.
# CONFIRMED OKX values (from @okxweb3/x402-* SDK) — this is the LIVE prod config:
# DALANG_X402_PAYTO=<your X Layer wallet>                       # recipient — enables the gate
# DALANG_X402_FACILITATOR=https://web3.okx.com/facilitator      # OKX facilitator (/verify + /settle)
# DALANG_X402_NETWORK=eip155:196                                # X Layer mainnet (CAIP-2)
# DALANG_X402_ASSET=0x779ded0c9e1022225f8e0630b35a9b54be713736  # USDT0 on X Layer (EIP-3009)
# DALANG_X402_ASSET_NAME=USD₮0                                  # EIP-712 domain name (exact scheme)
# DALANG_X402_ASSET_VERSION=1                                   # EIP-712 domain version
# DALANG_X402_AMOUNT=490000                                     # price in atomic units ($0.49, 6dp)
# DALANG_X402_TIMEOUT=600                                       # auth window (s) > worst-case render
# X Layer token-gating (opt-in) — restrict renders to holders of a token/NFT:
# DALANG_TOKENGATE_CONTRACT=       # ERC-20/721 contract on X Layer; enables the gate
# DALANG_TOKENGATE_MIN=1           # min balance in RAW UNITS (ERC-721 = NFT count;
#                                  #   18-dec ERC-20: 1 token = 1000000000000000000)
# DALANG_RPC_URL=https://rpc.xlayer.tech   # X Layer JSON-RPC for the balanceOf read
# NFT royalties (EIP-2981) added to mint metadata:
# DALANG_ROYALTY_BPS=500           # 500 = 5% secondary-sale royalty
# DALANG_ROYALTY_RECIPIENT=        # X Layer address that receives royalties
# Large-output offload (beats the serverless ~4.5 MB response cap):
# DALANG_MAX_RESPONSE_BYTES=4300000 # over this the whole inline body (video+poster+srt)
#                                    # is offloaded to storage if configured, else warned
# DALANG_UPLOAD_ENDPOINT=          # S3/R2/Blob-compatible base URL to PUT the mp4 to
# DALANG_UPLOAD_AUTH=              # optional Authorization header for the PUT
# DALANG_UPLOAD_PUBLIC_BASE=       # public base for the returned URL (if != endpoint)
# DALANG_VIDEO_MAX_WAIT=240        # cinematic poll budget (keep < serverless maxDuration)
# DALANG_KEEP_FILES=       # set to keep per-render files on disk (default: clean up)
